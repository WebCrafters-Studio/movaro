# WordPress Core
/.wordpress/
.wp-env.override.json
.wp-env.json

# Dependencies
node_modules/
vendor/
!wp/wp-content/plugins/**/vendor/

# Build artifacts
dist/
build/
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
wp/wp-content/debug.log

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Uploads (optional - uncomment if you don't want to track uploads)
wp/wp-content/uploads/

# Temporary files
*.tmp
*.temp
.cache/

# Package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# Import folder (production backups)
import/

# ACF JSON (optional - comment out if you want to track ACF fields)
#wp/wp-content/themes/*/acf-json/*.json
