{
    "mappings": {
        "wp-content": "./wp/wp-content",
        "import": "./import"
    },
    "phpmyadminPort": 9001,
    "themes": [
        "./wp/wp-content/themes/wcs"
    ],
    "plugins": [
        "./wp/wp-content/plugins/starter-block"
    ],
    "config": {
        "WP_HOME": "http://dev.local:8888",
        "WP_SITEURL": "http://dev.local:8888"
    },
    "env": {
        "development": {
            "config": {
                "WP_DEBUG": true,
                "WP_DEBUG_LOG": true,
                "WP_DEBUG_DISPLAY": true,
                "SCRIPT_DEBUG": false
            }
        },
        "tests": {
            "port": 3000,
            "mysqlPort": 13306,
            "phpmyadminPort": 9002
        }
    }
}